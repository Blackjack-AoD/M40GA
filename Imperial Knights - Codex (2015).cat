              <constraints>
                <constraint id="febb-67b2-bb61-7972" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/>
                <constraint id="f081-8d87-83d0-20b3" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <profiles>
