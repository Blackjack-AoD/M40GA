                    <selectionEntry id="4118-525f-35fb-9a07" name="Icon of Glory" hidden="false" collective="false" import="true" type="upgrade">
                      <constraints>
                        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
                      </constraints>
                      <profiles>
                        <profile id="d741-9efd-409d-7aa8" name="Icon of Glory" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has
                                                            either +1 BS or +1 WS (declared before
                                                            the game begins. Should the army's
                                                            warlord be within 2" of the vehicle, the
                                                            range of any Command Trait he has rolled
                                                            on the warlord traits table is increased
                                                            by +6" In missions that use Objectives
                                                            and Victory points to determine the
                                                            winner, the destruction of the vehicle
                                                            counts as an additional Secondary
                                                            Objective, earning the opposing player
                                                            an extra +1 Victory point.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <costs>
                        <cost name="pts" typeId="points" value="100.0"/>
                      </costs>
                    </selectionEntry>
                    <selectionEntry id="8e16-07b5-8245-9205" name="Shrouded Provenance" hidden="false" collective="false" import="true" type="upgrade">
                      <constraints>
                        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
                      </constraints>
                      <profiles>
                        <profile id="3bbc-896b-5f2a-ae5c" name="Shrouded Provenance" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the
                                                            Venerable special rule. The vehicle
