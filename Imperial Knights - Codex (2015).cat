                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 3, Rending, Multiple Wounds (3)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="ecdc-164c-02e5-5a28" name="Sustained Hits" hidden="false">
                  <description>Weapons with **[SUSTAINED HITS X]** in their profile are known as Sustained Hits weapons. Each time an attack is made with such a weapon, if a Critical Hit is rolled, that attack scores a number of additional hits on the target as denoted by ‘x’</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup id="5fbc-6565-4255-7580" name="Weapon Upgrades" hidden="false" collective="false" import="true">
