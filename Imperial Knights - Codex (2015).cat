              <selectionEntries>
                <selectionEntry id="72eb-16c4-0f6a-0125" name="Volkite veuglaire" hidden="false" type="upgrade" collective="false" import="true">
                  <constraints>
                    <constraint id="1590-a5ee-e6c1-5914" type="max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/>
