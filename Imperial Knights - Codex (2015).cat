            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Walker)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="c1e3-6387-6d9d-1418" name="Impetuous Glory" hidden="false">
          <description>Each time this model makes a charge move, until the end of the turn, add 1 to the Attacks characteristic of this model's reaper chain-cleaver - strike profile, and add 2 to the Attacks characteristic of this model's reaper chain-cleaver - sweep profile.</description>
        </rule>
        <rule id="b60b-d0e6-8321-b423" name="Deadly Demise" hidden="false">
          <description>Some models have 'Deadly Demise x' listed in their abilities. When such a model is destroyed, roll one D6 before removing it from play (if such a model is a TRANSPORT, roll before any embarked models disembark). On a 6, each unit within 6" of that model suffers a number of mortal wounds denoted by 'x' (if this is a random number, roll separately for each unit within 6").</description>
        </rule>
        <rule id="cd0f-ca1c-98db-560c" name="Damaged: 1-5 Wounds Remaining" hidden="false">
          <description>While this model has 1-5 wounds remaining, subtract 3 from this model's Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</description>
        </rule>
        <rule id="737e-a3aa-1ddb-ffe9" name="Invulnerable Save (5+*)" hidden="false">
          <description/>
        </rule>
      </rules>
