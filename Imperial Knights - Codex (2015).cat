          <selectionEntryGroups>
            <selectionEntryGroup id="80ce-f178-6d48-751d" name="Left arm" hidden="false" collective="false" import="true" defaultSelectionEntryId="8a5d-6f42-f584-8efb">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1393-d949-1f2d-43d2" type="min"/>
