      <rules>
        <rule id="4bc1-c983-c417-e5fd" name="The Lords of House Terryn" hidden="false">
          <description>All models in this Formation have the vehicle (Super-heavy Walker,
                        Character) unit type, Weapon Skill 5 and Ballistic Skill 5. In addition,
                        they can each select items from the Heirlooms of the Knightly Houses list.</description>
        </rule>
