                    <profile id="7f5f-0e2d-2b1d-b84d" name="Cerastus Shock Lance (Energy Blast)" publicationId="6940-50fe-pubN79786" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">18"</characteristic>
                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 6, Concussive</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule id="ee01-ecc2-ab4f-6592" name="Swift Strike" publicationId="6940-50fe-pubN79786" page="0" hidden="false">
                      <description>The weapon gains a +1 bonus to Initiative
                                                on any turn it charges into close combat.</description>
                    </rule>
                  </rules>
