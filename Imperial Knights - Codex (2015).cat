                <constraint id="c18b-41a5-9c59-42be" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <profiles>
                <profile id="fb61-2ebc-4f3c-6c2a" name="Conversion beam obliterator" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36"</characteristic>
