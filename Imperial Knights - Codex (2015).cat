        <profile id="3d6f-5c45-2ced-3422" name="Blessed Autosimulacra" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a vehicle has suffered Hull Point damage at the
                            end of the controlling player's turn, roll a D6. On a 6, one lost Hull
                            Point is restored.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="6dd1-57c8-4c42-bfb4" name="Overtaxed Reactor" hidden="false">
          <description>When destroyed, the Knight adds +1 to the result rolled on the
                        Catastrophic Damage table.</description>
        </rule>
      </rules>
