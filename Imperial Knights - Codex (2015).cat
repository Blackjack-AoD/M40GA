                <profile id="a9cc-fb50-8e7a-aa14" name="Void Shields" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Reaver Titans have 4 Void Shields.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="69d2-7492-d2aa-72b4" name="Reactor Meltdown" hidden="false">
                  <description>If the Reaver Titan suffers a Titanic Explosion!
                                        result on the Catastrophic Damage Table, it plasma reactor
                                        goes nuclear! All hits from this Titanic Explosion! are
                                        resolved as being froma Destroyer Weapon.</description>
                </rule>
              </rules>
