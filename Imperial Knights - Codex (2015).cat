        <profile id="a16f-710e-e050-b3d6" name="Blessed Autosimulacra" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a vehicle has suffered Hull Point damage at the
                            end of the controlling player's turn, roll a D6. On a 6, one lost Hull
                            Point is restored.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="d730-4a07-ea6e-4b8c" name="Macro-extinction Targeting Protocols" hidden="false">
          <description>When making shooting attacks against targets of the Super-heavy or
                        Gargantuan Creature type, the Cerastus Knight-Atrapos counts its weapons as
                        Twin-linked.</description>
        </rule>
        <rule id="4fc9-d979-1fcd-d00b" name="Catastrophic Destruction" hidden="false">
          <description>When destroyed, the Cerastus Knight-Atrapos adds +2 to the result
                        rolled on the
                        Catastrophic Damage table.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="81c3-4ff6-2e76-86cc" hidden="false" targetId="280d-1a0c-5916-3012" type="rule"/>
