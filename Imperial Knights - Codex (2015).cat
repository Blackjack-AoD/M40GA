            <selectionEntry id="3886-7aaf-98c4-2474" name="Plasma executor" hidden="false" type="upgrade" collective="false" import="true">
              <constraints>
                <constraint id="0804-7464-8efd-56d0" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/>
