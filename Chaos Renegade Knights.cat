                  </selectionEntryGroups>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="9ae1-81d0-24ba-0b2f" name="Electroscourge" hidden="false" type="upgrade" collective="false" import="true">
