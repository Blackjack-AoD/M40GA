              <profiles>
                <profile id="7e11-fb18-b4c2-222b" name="Volkite chierovile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">30"</characteristic>
