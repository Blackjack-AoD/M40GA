                <selectionEntry id="5354-40ad-63da-0830" name="Hellstorm autocannons" hidden="false" type="upgrade" collective="false" import="true">
                  <profiles>
                    <profile id="de00-2fc0-4cd3-0cd9" name="Hellstorm autocannons" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48"</characteristic>
                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 3, Twin-linked, Multiple Wounds (1)</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule id="b4a1-a836-1421-e5d4" name="Anti-" hidden="false">
                      <description>Weapons with **[ANTI-KEYWORD X+]** in their profile are known as Anti weapons. Each time an attack is made with such a weapon against a target with the keyword after the word ‘Anti-’, an unmodified Wound roll of ‘x+’ scores a Critical Wound.</description>
                    </rule>
                    <rule id="d0fa-0550-bd38-3f85" name="Twin-linked" hidden="false">
                      <description>Weapons with **[TWIN-LINKED]** in their profile are known as Twin-linked weapons. Each time an attack is made with such a weapon, you can re-roll that attack’s Wound roll.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                  </costs>
                </selectionEntry>
              </selectionEntries>
