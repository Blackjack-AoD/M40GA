    <selectionEntry id="e8cc-e2ba-743e-a1a2" name="Kapricus Carrier" hidden="false" type="model" collective="false" import="true">
      <comment>Converted from wh40k-10e by translate.py. Source catalogue f616-3f08-ee8e-3349, source entry cfbc-9eeb-badb-b28c, source name 'Kapricus Carrier'.</comment>
      <constraints>
        <constraint id="9782-0b55-e32f-1197" type="max" field="selections" scope="force" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile id="b9f6-404c-f35b-4a72" name="Kapricus Carrier" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
          <characteristics>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">10</characteristic>
            <characteristic name="Side" typeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e">10</characteristic>
            <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">10</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Tank, Transport, Hover)</characteristic>
          </characteristics>
        </profile>
        <profile id="7424-9d0b-ed35-1942" name="Kapricus Carrier" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 5 Hernkyn Yaegir models. It has a single access point in the rear.</characteristic>
            <characteristic name="Fire Points" typeId="fe20-e124-2c11-86ee">0</characteristic>
            <characteristic name="Access Points" typeId="21e5-4518-a31c-7e56">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="0dc7-932b-9abc-e053" name="Scanner Uplinks" hidden="false">
          <description>In your shooting phase, after this model has shot, select one enemy unit (excluding Monsters and Vehicles) hit by one or more of those attacks. Until the start of your next turn, that enemy unit is suppressed. While a unit is suppressed, each time a model in that unit makes an attack, subtract 1 from the Hit roll.</description>
        </rule>
        <rule id="10f5-afbf-0bd8-bc73" name="Deadly Demise" hidden="false">
          <description>This model follows the standard Vehicle Damage rules for explosions when destroyed - no additional effect.</description>
        </rule>
        <rule id="b244-2d70-950f-8906" name="Firing Deck" hidden="false">
          <description>Models embarked within this transport may fire out using its Fire Points, as per the standard Fire Points rule.</description>
        </rule>
        <rule id="295a-e00b-2a49-ad24" name="Scouts" hidden="false">
          <description>This unit has the Scout special rule (it may make a pre-game move as per the Warhammer 40,000 rulebook).</description>
        </rule>
        <rule id="297a-e425-6a31-33a8" name="Guerrilla Adepts" hidden="false">
          <description>In your Shooting phase, just after this unit is selected to shoot, you may select one enemy unit. Until the end of the phase, this unit's attacks can only target that unit. If one or more of those attacks hit, until the start of your next Shooting phase that enemy unit suffers -2" Move and -1 to its hit rolls.</description>
        </rule>
        <rule id="db61-3f30-8857-b7f9" name="Firebase Control (Aura)" hidden="false">
          <description>While a friendly Leagues of Votann Infantry unit is wholly within 6" of this Transport, ranged weapons equipped by models in that Infantry unit have the Deflagrate special rule.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="d60c-fac6-39f6-4d78" name="No Force Org Slot" hidden="false" targetId="ff36a6f3-19bf-4f48-8956-adacfd28fe74" primary="true" />
      </categoryLinks>
