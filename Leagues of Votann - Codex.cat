n" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="228d-d048-ef61-4049" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><profiles><profile id="9805-18bd-db0b-40a1" name="Warrior" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic></characteristics></profile><profile id="de6e-f9de-9b4b-4cd9" name="Theyn" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic></characteristics></profile></profiles><rules><rule id="a22a-839a-4051-4f7e" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="8c53-017e-34b5-40e9" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="2e56-680c-55ce-426c" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule><rule id="86cd-b5d7-c6b3-4b69" name="Mounted Assault" hidden="false"><description>When deploying a unit with this rule that has purchased dedicated transports, you may split the squad into separate units. Split the squad so that each vehicle has its transport capacity as filled as possible. The dedicated transports and the models embarked within them are then considered separate units for all intents and purposes. Any remaining models that cannot embark upon the dedicated transports remain as their own separate unit.</description></rule></rules><costs><cost name="pts" typeId="points" value="60" /></costs></selectionEntry><selectionEntry id="dd8b-fa4f-e4b2-c2ab" name="Kâhl" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="fd3c-c846-fec8-4b0b" name="HQ" hidden="false" targetId="848a6ff2-0def-4c72-8433-ff7da70e6bc7" primary="true" /></categoryLinks><selectionEntries><selectionEntry id="e6e4-7c90-2916-42b5" name="Master-craft a melee weapon" hidden="false" type="upgrade" collective="false" import="true"><constraints><constraint id="75ac-2314-2c7f-43c7" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="d98f-bf9f-c843-4b1e" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="65c5-e2b9-34ee-4e21" name="Master-craft a melee weapon" hidden="false"><description>The chosen melee weapon gains the Master-crafted special rule.</description></rule></rules><costs><cost name="pts" typeId="points" value="15" /></costs></selectionEntry><selectionEntry id="3228-3181-a8fd-45f2" name="Master-craft a ranged weapon" hidden="false" type="upgrade" collective="false" import="true"><constraints><constraint id="f049-3f02-2825-439f" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="faf1-15dd-794d-4983" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="2620-6e48-f217-4854" name="Master-craft a ranged weapon" hidden="false"><description>The chosen ranged weapon gains the Master-crafted special rule.</description></rule></rules><costs><cost name="pts" typeId="points" value="15" /></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="eea8-a9da-18f1-454d" name="Plasma Weapon" hidden="false" collective="false" defaultSelectionEntryId="be67-a74d-fa7f-4a76"><constraints><constraint id="bcfc-150f-7717-44f2" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="b067-99bc-10b5-403e" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="be67-a74d-fa7f-4a76" name="Plasma Sword" hidden="false" type="upgrade" collective="false" import="true"><entryLinks><entryLink id="abab-ecd5-c7da-4f16" name="Plasma Sword" hidden="false" collective="false" import="true" targetId="wpn-200