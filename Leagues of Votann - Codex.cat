lse" import="true" targetId="wpn-20060" type="selectionEntry"><constraints><constraint id="9b04-7330-798a-4c3f" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="4480-2a9e-2e0d-4701" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><costs><cost name="pts" typeId="points" value="10" /></costs></selectionEntry><selectionEntry id="dc72-ba94-0797-488e" name="Graviton Blast Cannon" hidden="false" type="upgrade" collective="false" import="true"><constraints><constraint id="e634-0b37-6570-4d5c" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="1883-6a18-1f08-4df8" type="max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="b651-8c0c-5164-404a" name="Graviton Blast Cannon" hidden="false" collective="false" import="true" targetId="wpn-20074" type="selectionEntry"><constraints><constraint id="5592-4935-5b63-47f5" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="842a-2588-0bbe-463d" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><costs><cost name="pts" typeId="points" value="15" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><profiles><profile id="b5e3-3764-2e05-4fb0" name="Thunderkyn" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic></characteristics></profile></profiles><rules><rule id="8588-d924-526a-49a7" name="Very Bulky" hidden="false"><description>Very Bulky models instead count as three models.</description></rule><rule id="5b40-df8d-8e88-47f0" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="af31-3843-1e91-461e" name="Split Fire" hidden="false"><description>This unit has the Split Fire special rule (see the main rulebook).</description></rule><rule id="17de-3286-f760-41af" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="1d9c-c352-5b2c-41c1" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule></rules><costs><cost name="pts" typeId="points" value="100" /></costs></selectionEntry><selectionEntry id="5ecf-83a1-7fe5-96e0" name="Hekaton Land Fortress" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="9bc8-e634-eb4d-4224" name="Heavy Support" hidden="false" targetId="abf5fd55-9ac7-4263-8bc1-a9fb0a8fa6a6" primary="true" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="864b-c2c5-8cc6-4404" name="Turret mounted weapon" hidden="false" collective="false" defaultSelectionEntryId="e5dd-60d7-98ad-4a28"><constraints><constraint id="b1c4-f2a9-d94c-44ae" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSe