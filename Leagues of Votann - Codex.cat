                  <profiles>
                    <profile id="cea1-6b57-5007-6378" name="SP conversion beamer" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24"</characteristic>
                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2, Rending, Multiple Wounds (2)</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule id="ba2f-986e-ba18-d02c" name="Lethal Hits" hidden="false">
                      <description>Weapons with **[LETHAL HITS]** in their profile are known as Lethal Hits weapons. Each time an attack is made with such a weapon, a Critical Hit automatically wounds the target.</description>
                    </rule>
                    <rule id="2982-0e16-e70f-cfbf" name="Conversion (Thunderkyn)" hidden="false">
                      <description>Each time an attack made with this weapon targets an enemy unit that is not within 12", an unmodified Hit roll of 4+ scores a Critical Hit.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="88e9-45c8-23a8-ac78" name="Weapon Upgrades" hidden="false" collective="false" import="true">
                      <selectionEntryGroups>
