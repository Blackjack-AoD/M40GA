    <selectionEntry id="99d6-25cd-943b-c77e" name="Hernkyn Yaegirs" hidden="false" type="unit" collective="false" import="true">
      <comment>Converted from wh40k-10e by translate.py. Source catalogue f616-3f08-ee8e-3349, source entry 5b0b-c18d-1470-44bb, source name 'Hernkyn Yaegirs'.</comment>
      <constraints>
        <constraint id="b96b-11eb-1706-5405" type="max" field="selections" scope="force" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile id="a6ec-b279-71fe-cabf" name="Hernkyn Yaegirs" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">3</characteristic>
