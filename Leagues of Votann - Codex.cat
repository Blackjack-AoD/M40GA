            <selectionEntry id="6cb9-fd53-cf3b-371e" name="Autoch-pattern bolt pistol" hidden="false" type="upgrade" collective="true" import="true">
              <constraints>
                <constraint id="31b7-9703-b174-8777" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
