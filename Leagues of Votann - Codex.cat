0f" name="Bulky" hidden="false"><description>This unit has the Bulky special rule (see the main rulebook).</description></rule></rules><costs><cost name="pts" typeId="points" value="20" /></costs></selectionEntry><selectionEntry id="ad95-d14f-138e-4b80" name="Concussion Hammer (replaces Heavy Plasma Axe)" hidden="false" type="upgrade" collective="false" import="true"><constraints><constraint id="d51f-0d0b-727b-4246" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="70c6-c596-3e7a-4f10" type="max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="c69b-ed5c-3602-4811" name="Concussion Hammer" hidden="false" collective="false" import="true" targetId="wpn-20038" type="selectionEntry"><constraints><constraint id="739a-ba42-3e2b-46c3" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="820a-6257-ece9-400b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><rules><rule id="aefe-5b2d-2e96-40c9" name="Concussion Hammer (replaces Heavy Plasma Axe)" hidden="false"><description>Any Beserk may replace their Heavy Plasma Axe. 10 pts per model.</description></rule></rules><costs><cost name="pts" typeId="points" value="10" /></costs></selectionEntry><selectionEntry id="ac9a-02f5-e4b8-444e" name="Two Concussion Gauntlets (replaces Heavy Plasma Axe)" hidden="false" type="upgrade" collective="false" import="true"><modifiers><modifier type="set" field="2f96-6b27-3624-420c" value="2"><conditions><condition field="selections" scope="parent" childId="c5e2-c0af-b781-4735" type="atLeast" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="066b-36ec-b02f-4ab3" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="2f96-6b27-3624-420c" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="516d-a538-b228-4c89" name="Concussion Gauntlet" hidden="false" collective="false" import="true" targetId="wpn-20036" type="selectionEntry"><constraints><constraint id="c690-0ce0-d7aa-4ae3" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="73e3-1498-5c12-419c" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><rules><rule id="7dfb-6995-b8b9-4644" name="Two Concussion Gauntlets" hidden="false"><description>One Beserk per five models replaces their Heavy Plasma Axe for two Concussion Gauntlets (2 pts).</description></rule></rules><costs><cost name="pts" typeId="points" value="2" /></costs></selectionEntry></selectionEntries><profiles><profile id="9184-805e-59df-4a6a" name="Beserk" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">9</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+</characteristic></characteristics></profile></profiles><rules><rule id="1373-1c7e-2573-4b61" name="Furious Charge" hidden="false"><description>This unit has the Furious Charge special rule (see the main rulebook).</description></rule><rule id="589b-fcd8-2cfe-47cc" name="Feel No Pain (5+)" hidden="false"><description>This unit has the Feel No Pain (5+) special rule (see the main rulebook).</description></rule><rule id="4968-1142-cb07-48e6" name="Cyberstimms" hidden="false"><description>When slain in combat, a model with this rule is not removed as a casualty until after it makes its attacks this combat phase. If the model has already attacked when it was slain, then this rule does not take effect.</description></rule><rule id="dcf2-d661-efae-48c8" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="bdfd-46d9-2016-4768" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="ad69-c8b9-8121-49bd" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule></rules><costs><cost name="pts" typeId="points" value="115" /></costs></selectionEntry><selectionEntry id="3f22-9d0d-8574-d337" name="Hernkyn Pioneers" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="5ed4-aa88-b78e-41f9" name="Fast Attack" hidden="false" targetId="c274d0b0-5866-44bc-9810-91c136ae7438" primary="true" /></categoryLinks><selectionEntries><selectionEntry id="968d-ead2-bc45-4024" name="Pioneer" hidden="false" type="model" collective="false" import="true"><modifiers><modifier type="increment" field="ba9b-c7ef-fba5-4836" value="-1"><repeats><repeat field="selections" scope="parent" childId="9ee1-ff70-24a1-45bd" value="1" repeats="1" roundUp="false" shared="true" includeChildSelections="false" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="519d-3b27-7e0a-4985" value="-1"><repeats><repeat field="selections" scope="parent" childId="9ee1-ff70-24a1-45bd" value="1" repeats="1" roundUp="false" shared="true" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><constraints><constraint id="ba9b-c7ef-fba5-4836" type="min" field="selections" scope="parent" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="519d-3b27-7e0a-4985" type="max" field="selections" scope="parent" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="396f-644f-7d6f-4a80" name="Magna-Coil Bike" hidden="false" collective="false" import="true" targetId="eq-20018" type="selectionEntry"><constraints><constraint id="40b7-9347-4c05-4f0a" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="975e-5cd6-b5d1-4817" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="332d-a93e-482a-4e7e" name="Autocannon" hidden="false" collective="false" import="true" targetId="s3-ac" type="selectionEntry"><constraints><constraint id="a4dc-2d1c-dc9a-403a" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="d7e9-0343-924f-428c" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="1632-59e3-c8c6-45ad" name="Bolt Pistol" hidden="false" collective="false" import="true" targetId="wpn-autoch-pistol-0001"