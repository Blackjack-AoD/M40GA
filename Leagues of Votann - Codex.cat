                  <profiles>
                    <profile id="7195-5c30-1b6e-b1c7" name="➤ Ancestral Wrath - witchfire" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
