<sharedSelectionEntryGroups><selectionEntryGroup id="grp-20116" name="Warlord Trait (if Warlord, choose 1 or roll D6)" hidden="false" collective="false">
      <constraints>
        <constraint id="c-20117" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="c-20118" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries><selectionEntry id="wt-20104" name="Ancestral Bearing" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20105" name="Ancestral Bearing" hidden="false"><description>The Warlord gains the Resolute special rule, and friendly units within 12" of the Warlord also benefit from the Resolute special rule. In addition, when determining assault results for any of your units in combat, add 1 to your total if your Warlord is locked in combat.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20106" name="Warrior Lord" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20107" name="Warrior Lord" hidden="false"><description>The Warlord grants the Monster Hunter and Furious Charge special rules to themselves and their unit.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20108" name="A Long List" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20109" name="A Long List" hidden="false"><description>After deploying but before rolling to seize the initiative, place a single Grudge Token on the enemy Warlord's unit. The Warlord gains Hatred(Enemy Warlord).</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20110" name="Guild Affiliate" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20111" name="Guild Affiliate" hidden="false"><description>The Warlord and their unit gain the Scout and Objective Secured special rule.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20112" name="Unrelenting Toil" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20113" name="Unrelenting Toil" hidden="false"><description>The Warlord and their unit gains the Counter Attack and Move through Cover special rules.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20114" name="Grim Demeanour" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20115" name="Grim Demeanour" hidden="false"><description>The Warlord gains the Fearless and the "It Will Not Die" special rules.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry></selectionEntries>
    </selectionEntryGroup><selectionEntryGroup id="grp-20147" name="Relics" hidden="false" collective="false">
      <constraints>
        <constraint id="c-20148" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="c-20149" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries><selectionEntry id="rl-20119" name="Aktôl's Fortress" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20120" name="Aktôl's Fortress" hidden="false"><description>In the first round of an assault, enemy units engaged with the bearer of this relic strike at initiative 1.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="30" /></costs>
        </selectionEntry><selectionEntry id="rl-20121" name="Ancestral Crest" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20122" name="Ancestral Crest" hidden="false"><description>Warlord only. The bearer of this relic gains an additional Warlord Trait.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="20" /></costs>
        </selectionEntry><selectionEntry id="rl-20123" name="Exactor" hidden="false" type="upgrade" collective="false">
          <profiles><profile id="prof-20124" name="Exactor" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Unwieldy, Concussive, Sunder, Specialist Weapon, Killing Blow (Attacks that roll a '6' to wound gain the Instant Death special rule)</characteristic>
              </characteristics>
            </profile></profiles>
          <costs><cost name="pts" typeId="points" value="25" /></costs>
        </selectionEntry><selectionEntry id="rl-20125" name="The First Knife" hidden="false" type="upgrade" collective="false">
          <profiles><profile id="prof-20126" name="The First Knife" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
