pe="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="701d-0b29-ca9d-41ca" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="f3b5-49bf-c02d-4a97" name="Exo-Armour" hidden="false" collective="false" import="true" targetId="eq-20016" type="selectionEntry"><constraints><constraint id="5577-d6e5-e3f3-4e53" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="b2d9-9220-8982-43cb" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="183c-0201-0bc1-48db" name="Twin-linked Boltgun" hidden="false" collective="false" import="true" targetId="s3-tlbolt" type="selectionEntry"><constraints><constraint id="2b40-b047-1cc2-4507" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="5fb1-2bce-61dd-4d49" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="9b17-e6a5-c428-4cc3" name="Warlord Trait" hidden="false" collective="false" import="true" targetId="grp-20116" type="selectionEntryGroup"></entryLink><entryLink id="efe8-9dde-e4e5-4db2" name="Relic" hidden="false" collective="false" import="true" targetId="grp-20147" type="selectionEntryGroup"></entryLink></entryLinks><profiles><profile id="2b79-ec24-4834-41c3" name="Einhyr Champion" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">6</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">5</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">9</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic></characteristics></profile></profiles><rules><rule id="a5c8-f171-6884-425c" name="Bulky" hidden="false"><description>This unit has the Bulky special rule (see the main rulebook).</description></rule><rule id="4539-f2c1-ae73-4287" name="Independent Character" hidden="false"><description>This unit has the Independent Character special rule (see the main rulebook).</description></rule><rule id="a444-290f-bc31-49b8" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="c3be-beea-0814-481d" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="c6a7-2ff4-bb32-4440" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule></rules><costs><cost name="pts" typeId="points" value="120" /></costs></selectionEntry><selectionEntry id="57df-7ce3-b5c1-f4c1" name="Grimnyr" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="0e00-bb48-405c-4689" name="HQ" hidden="false" targetId="848a6ff2-0def-4c72-8433-ff7da70e6bc7" primary="true" /></categoryLinks><selectionEntries><selectionEntry id="5f0e-1a2f-42e0-469e" name="Upgrade to Psyker (Mastery Level 3)" hidden="false" type="upgrade" collective="false" import="true"><constraints><constraint id="9d12-494e-21f1-418e" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="79b8-97bc-8142-4c87" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="a5bb-e957-d3bb-435b" name="Psyker (Mastery Level 3)" hidden="false"><description>This model is instead a Psyker with Mastery Level 3.</description></rule></rules><costs><cost name="pts" typeId="points" value="50" /></costs></selectionEntry><selectionEntry id="eb78-b9d7-0e9f-4b81" name="C0RV Drone (Boltgun)" hidden="false" type="model" collective="false" import="true"><constraints><constraint id="7d2c-9422-b233-47e7" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="9d0f-4bf9-ebc9-4d60" type="max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="6d3f-1cda-9c4d-4fe7" name="Boltgun" hidden="false" collective="false" import="true" targetId="wpn-autoch-bolter-0001" type="selectionEntry"><constraints><constraint id="42fc-6994-768e-4782" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="38d5-2e14-b394-4540" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><profiles><profile id="6f3f-cf64-ee2c-44df" name="C0RV" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">3</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">-</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">-</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">-</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">-</characteristic></characteristics></profile></profiles><rules><rule id="e80f-8d3d-f8b3-46ec" name="Companion" hidden="false"><description>Models with this rule are not targetable in any way. Models with this rule do not block line of sight and other models may move over and through models with this rule. When the attached character and their unit moves, place these models as close as possible to the attached character. When the attached character is slain, remove these models with this rule. Models with this rule may make attacks in the shooting/combat phase, in which case they can target any eligible models that their attached character can target. Models with this rule never gain the benefits for assaulting.</description></rule></rules><costs><cost name="pts" typeId="points" value="5" /></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="cc96-e8a9-597f-4ca6" name="Psychic discipline" hidden="false" collective="false"><constraints><constraint id="1f28-7636-c4f1-4e1a" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="1306-cf02-5b51-4d55" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="e744-ebc4-cb30-4d18" name="Divination" hidden="false" collective="false" import="true" targetId="aec7-f89f-3f7c-596b" type="selectionEntry"></entryLink><entryLink id="6109-71c2-84f8-4a20" name="Telekinesis" hidden="false" collective="false" import="true" targetId="e05c-cec2-bad0-4445" type="selectionEntry"></entryLink><entryLink id="bfd2-3ca7-09cd-4a59" name="Geokinesis" hidden="false" collective="false" import="true" targetId="s3-geokinesis" type="selectionEntry"></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><entryLinks><entryLink id="23d8-d3fb-b40c-45ca" name="Ancestor Stave" hidden="false" collective="false" import="true" targetId="s3-stave" type="selectionEntry"><constraints><constraint id="a732-0b07-0cad-4725" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="5bd4-e496-a7f8-41ed" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="e169-09a7-d556-495e" name="Ward Crest" hidden="false" collective="false" import="true" targetId="eq-20032" type="selectionEntry"><constraints><constraint id="eac1-3e06-de34-4e77" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="39a2-2cd0-a8b4-486d" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="9025-0063-8a78-4197" name="Warlord Trait" hidden="false" collective="false" import="true" targetId="grp-20116" type="selectionEntryGroup"></entryLink><entryLink id="6ebf-63d1-4632-428e" name="Relic" hidden="false" collective="false" import="true" targetId="grp-20147" type="selectionEntryGroup"></entryLink></entryLinks><profiles><profile id="04bb-5290-0471-4614" name="Grimnyr" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic></characteristics></profile></profiles><rules><rule id="2140-d638-0325-4d2b" name="Independent Character" hidden="false"><description>This unit has the Independent Character special rule (see the main rulebook).</description></rule><rule id="85ab-d4b2-8bb2-4a07" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="11e0-01c2-cf5b-4899" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="23e5-9068-2377-477e" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule><rule id="81e5-9fc7-0c22-4a5b" name="Adamantium Will" hidden="false"><description>A unit that contains at least one model with this special rule receives a +1 bonus to Deny the Witch tests.</description></rule><rule id="b6a3-b594-f197-44df" name="Psyker (Mastery Level 2)" hidden="false"><description>This model is a Psyker with Mastery Level 2. Grimnyrs generate their powers from the Divination, Telekinesis or Geokinesis disciplines.</description></rule><rule id="5c05-315d-80c8-42eb" name="Companion (C0RV only)" hidden="false"><description>Models with this rule are not targetable in any way. Models with this rule do not block line of sight and other models may move over and through models with this rule. When the attached character and their unit moves, place these models as close as possible to the attached character. When the attached character is slain, remove these models with this rule. Models with this rule may make attacks in the shooting/combat phase, in which case they can target any eligible models that their attached character can target. Models with this rule never gain the benefits for assaulting.</description></rule></rules><costs><cost name="pts" typeId="points" value="90" /></costs></selectionEntry><selectionEntry id="e648-057e-71a9-4143" name="Brôkhyr Iron-master" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="bce5-88d7-c1a0-4e2a" name="HQ" hidden="false" targetId="848a6ff2-0def-4c72-8433-ff7da70e6bc7" primary="true" /></categoryLinks><selectionEntries><selectionEntry id="612f-3a38-7300-44f8" name="Ironkin Assistant" hidden="false" type="model" collective="false" import="true"><constraints><constraint id="04fb-1738-3224-48df" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="1d5a-cfee-5c97-4a8b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="3ccb-18ed-fc95-4a83" name="Inferno Pistol" hidden="false" collective="false" import="true" targetId="s3-inferno" type="selectionEntry"><constraints><constraint id="4176-9404-4674-4d25" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="bf7c-5fb0-f816-4318" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="c10f-7bab-993b-498d" name="Close Combat Weapon" hidden="false" collective="false" import="true" targetId="s3-ccw" type="selectionEntry"><constraints><constraint id="6f28-0c8d-b346-4ea2" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="0f62-d416-b194-40c0" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="7341-1f3c-2e35-42ac" name="Gravitic Concussion Grenades" hidden="false" collective="false" import="true" targetId="wpn-20072" type="selectionEntry"><constraints><constraint id="b901-237e-1ab2-4ff8" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="96f1-cdba-7fbf-4738" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="8828-306e-2b07-4e05" name="Pan Spectral Scanner" hidden="false" collective="false" import="true" targetId="eq-20024" type="selectionEntry"><constraints><constraint id="0141-0c61-856e-43ce" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="f57c-59ca-8b22-4e12" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><profiles><profile id="97ef-04ec-c1da-4e48" name="Ironkin Assistant" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic></characteristics></profile></profiles><rules><rule id="cc61-31aa-54c2-4bd8" name="Assistant" hidden="false"><description>A model with this rule does not prevent their attached character from joining another unit, this model simply joins the same unit as well.</description></rule><rule id="f5b4-df9c-aa8e-490a" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="d1ad-25a9-b415-443a" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="5d99-4528-c2af-4cfa" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule></rules><costs><cost name="pts" typeId="points" value="25" /></costs></selectionEntry><selectionEntry id="88bc-2203-069b-47db" name="E-Cog Drone" hidden="false" type="model" collective="false" import="true"><constraints><constraint id="6b67-d675-9bb7-4196" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="a516-3835-9ade-4e1d" type="max" field="selections" scope="parent" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="7165-d38b-04bf-4bca" name="Bolt Pistol" hidden="false" collective="false" import="true" targetId="wpn-autoch-pistol-0001" type="selectionEntry"><constraints><constraint id="8c4c-7da3-c5c7-4d0b" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="2f06-a343-aff1-45e7" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><profiles><profile id="b549-e9ce-5637-4b5f" name="E-Cog" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">3</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">-</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">-</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">-</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">-</characteristic></characteristics></profile></profiles><rules><rule id="43d5-4233-c13a-440a" name="Companion" hidden="false"><description>Models with this rule are not targetable in any way. Models with this rule do not block line of sight and other models may move over and through models with this rule. When the attached character and their unit moves, place these models as close as possible to the attached character. When the attached character is slain, remove these models with this rule. Models with this rule may make attacks in the shooting/combat phase, in which case they can target any eligible models that their attached character can target. Models with this rule never gain the benefits for assaulting.</description></rule><rule id="0253-4043-f6f8-4791" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule></rules><costs><cost name="pts" typeId="points" value="10" /></costs></selectionEntry><selectionEntry id="8393-a85d-7715-413f" name="Master-craft a melee weapon" hidden="false" type="upgrade" collective="false" import="true"><constraints><constraint id="2f4f-0cab-4ed2-4c20" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="679e-2eb5-c57d-4797" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="c3b9-7801-ff7f-4241" name="Master-craft a melee weapon" hidden="false"><description>The chosen melee weapon gains the Master-crafted special rule.</description></rule></rules><costs><cost name="pts" typeId="points" value="15" /></costs></selectionEntry><selectionEntry id="adaf-f3ba-4701-492f" name="Master-craft a ranged weapon" hidden="false" type="upgrade" collective="false" import="true"><constraints><constraint id="2b88-4881-6438-4f2e" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="90c1-9bbd-3794-46a8" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="3858-0ebc-76f8-483e" name="Master-craft a ranged weapon" hidden="false"><description>The chosen ranged weapon gains the Master-crafted special rule.</description></rule></rules><costs><cost name="pts" typeId="points" value="15" /></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="166f-d022-2144-4c70" name="Grav-rifle" hidden="false" collective="false" import="true" targetId="s3-gravrifle" type="selectionEntry"><constraints><constraint id="d661-3c40-41dd-4f8f" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="4288-25ef-5efa-4f3f" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="f7ee-6655-0f2f-44ae" name="Concussion Hammer" hidden="false" collective="false" import="true" targetId="wpn-20038" type="selectionEntry"><constraints><constraint id="b859-dbd6-f821-4001" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="c1dc-2d2c-8dd8-4050" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="85a9-e8c4-a2cb-4761" name="Assault Grenades" hidden="false" collective="false" import="true" targetId="eq-20410" type="selectionEntry"><constraints><constraint id="cda6-2577-8f09-4f1b" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="1a65-3780-2186-47f7" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="4e76-6e13-5865-46c5" name="Defensive Grenades" hidden="false" collective="false" import="true" targetId="s3-defgren" type="selectionEntry"><constraints><constraint id="4b95-3343-48a0-43e4" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="22b2-597f-ad85-4f6a" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="c315-cfd3-a2db-483e" name="Warlord Trait" hidden="false" collective="false" import="true" targetId="grp-20116" type="selectionEntryGroup"></entryLink><entryLink id="5200-fa7d-6724-4e2e" name="Relic" hidden="false" collective="false" import="true" targetId="grp-20147" type="selectionEntryGroup"></entryLink></entryLinks><profiles><profile id="a831-e763-b233-44ba" name="Iron-Master" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic></characteristics></profile></profiles><rules><rule id="a487-736e-c3b2-46f7" name="Independent Character" hidden="false"><description>This unit has the Independent Character special rule (see the main rulebook).</description></rule><rule id="2674-76ff-23af-4630" name="Brôkhyr's Guild" hidden="false"><description>In your shooting phase, instead of firing weapons, a model with this rule can repair a vehicle that they are embarked upon or in base contact with. To repair, roll a D6 and add +1 for each E-COG in the unit. On a 5+, either restore a hull point or remove a Weapon Destroyed or Immobilised result from that vehicle. If this unit contains an Ironkin Assistant, you can pick two different effects on a successful repair roll, but not 2 of the same.</description></rule><rule id="ac0b-7df3-7e8f-4b27" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="b572-d632-0664-4fda" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="afeb-45b8-bbc3-40e4" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule></rules><costs><cost name="pts" typeId="points" value="75" /></costs></selectionEntry><selectionEntry id="884c-efac-cea6-7d16" name="Einhyr Hearthguard" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="c084-e00d-fceb-4d94" name="Elites" hidden="false" targetId="638d74c6-bd97-4de5-b65a-6aaa24e9f4b2" primary="true" /></categoryLinks><selectionEntries><selectionEntry id="470a-43ff-ffa8-4cad" name="Hearthguard" hidden="false" type="model" collective="false" import="true"><constraints><constraint id="7f36-7fad-9350-42fa" type="min" field="selections" scope="parent" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="9e53-bf3b-9905-432a" type="max" field="selections" scope="parent" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="8781-4ed2-465c-4bf2" name="Volkanite Disintigrator" hidden="false" collective="false" import="true" targetId="wpn-20102" type="selectionEntry"><constraints><constraint id="9c00-827b-0235-4489" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="1095-6d53-5c7e-417c" type="max" field=