                        <constraint id="84bb-7020-a6c6-1d8a" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <profiles>
                        <profile id="2a25-1255-9cb3-9532" name="Plasma knife" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
