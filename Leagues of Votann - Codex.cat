ective="false" import="true" targetId="wpn-20072" type="selectionEntry"><constraints><constraint id="e78e-26fd-5d65-489b" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="8398-bbb0-dce2-47a1" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="a1cb-c276-19b3-4783" name="Warlord Trait" hidden="false" collective="false" import="true" targetId="grp-20116" type="selectionEntryGroup"></entryLink><entryLink id="d394-6989-50bf-4ccc" name="Relic" hidden="false" collective="false" import="true" targetId="grp-20147" type="selectionEntryGroup"></entryLink></entryLinks><profiles><profile id="f89f-edd4-a6ce-4366" name="Kâhl" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">3</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic></characteristics></profile></profiles><rules><rule id="de1b-d32b-01c0-4190" name="Independent Character" hidden="false"><description>This unit has the Independent Character special rule (see the main rulebook).</description></rule><rule id="a39b-9b58-4d22-48fd" name="Grim Efficiency" hidden="false"><description>After deploying but before rolling to seize the initiative, as long as you have a model with this rule in your army, place a single Grudge Token on an enemy unit.</description></rule><rule id="4b05-6a57-80d3-4b41" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="2446-0199-8cf9-4072" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="4957-b517-f686-4838" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule></rules><costs><cost name="pts" typeId="points" value="95" /></costs></selectionEntry><selectionEntry id="2657-a23d-7ddf-b9e8" name="Einhyr Champion" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="6dd3-745b-5f3d-495a" name="HQ" hidden="false" targetId="848a6ff2-0def-4c72-8433-ff7da70e6bc7" primary="true" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="6910-b71f-214f-4791" name="Melee weapon" hidden="false" collective="false" defaultSelectionEntryId="2446-1562-26b3-4bf9"><constraints><constraint id="79aa-c261-c7fd-4362" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="8e6e-9f8d-3ed8-42d8" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="2446-1562-26b3-4bf9" name="Darkstar Axe" hidden="false" type="upgrade" collective="false" import="true"><entryLinks><entryLink id="feb8-5991-ee9d-4532" name="Darkstar Axe" hidden="false" collective="false" import="true" targetId="wpn-20040" type="selectionEntry"><constraints><constraint id="fb0e-ab05-d1ee-48fb" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="83c1-8ce0-1d21-4e65" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelectio