                    <profile id="9bc7-7812-e5c6-2f49" name="Autoch-pattern combi-bolter" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
