          <selectionEntries>
            <selectionEntry id="8225-856b-822d-bf0e" name="Autoch-pattern bolt pistol" hidden="false" type="upgrade" collective="false" import="true">
              <constraints>
                <constraint id="ed3b-9a17-7fa8-1af2" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
