            <constraint id="5afe-d8b7-dbf5-cd41" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0" />
          </costs>
        </selectionEntry>
