  <sharedRules>
<rule id="rule-9001" name="Short-legged" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>Models with this rule have a 5&quot; Move characteristic instead of the usual 6&quot;. Does not affect Run, Charge, or any other move governed by other rules.</description>
  </rule>
<rule id="rule-9002" name="Votann" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>All models in this codex have the Votann special rule: once per game, a unit with this rule that would fall back from combat may instead remain locked in combat and fight as if it were the assault phase (Stubborn).</description>
  </rule>
<rule id="rule-9003" name="Sustained Hits (X)" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>A weapon with this rule generates X additional automatic hits each time an unmodified hit roll of 6 is made for it, on top of the hit already scored. These bonus hits go straight to the wound roll, skipping the hit roll.</description>
  </rule>
<rule id="rule-9004" name="Rending" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>A model with this special rule that makes an attack (shooting or close combat) which scores an unmodified roll of 6 To Wound automatically wounds the target and that attack is resolved at AP2, regardless of what AP the weapon normally has. (Replaces all references to the 10th Edition 'Devastating Wounds' keyword, per house-rule decision.)</description>
  </rule>
<rule id="rule-9005" name="Hostile Acquisition" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>At the start of each Game Turn, each Votann unit that does not control an objective marker gains this rule until the start of the next Game Turn: each time a model in this unit makes an attack that targets an enemy unit within range of an objective marker, add 1 to the hit roll. You can re-roll failed Run and charge rolls made for this unit.</description>
  </rule>
<rule id="rule-9006" name="Fortify Takeover" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>At the start of each Game Turn, each Votann unit that controls an objective marker gains this rule until the start of the next Game Turn: each time a model in this unit makes an attack, if this unit is within range of an objective marker it controls, add 1 to the hit roll. Each time this unit is attacked by a model with a higher Strength than this unit's Toughness (this unit is not a Vehicle), subtract 1 from the wound roll.</description>
  </rule>
<rule id="rule-9055" name="Formation: Firebase Kindred" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>If your army includes 2 or more Einhyr Hearthguard or Hearthkyn Warriors units and one Brôkhyr Iron-master, every Votann unit in your army fires Overwatch on unmodified hit rolls of 5+ instead of the usual 6+.</description>
  </rule>
<rule id="rule-9056" name="Formation: Grudge-bound Vanguard" book="Leagues of Votann (converted)" page="0" hidden="false">
    <profiles/><rules/><infoLinks/><modifiers/>
    <description>If your army includes 2 or more Elites choices and one Einhyr Champion or Berehk Stornbröw, models in Elites units gain the Fleet special rule (re-roll failed Run and charge distance rolls), and re-roll failed to-hit rolls in the first round of any combat they charged into.</description>
  </rule>
  </sharedRules>
  <sharedProfiles/>
</catalogue>
