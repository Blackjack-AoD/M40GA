                      </selectionEntryGroups>
                    </selectionEntryGroup>
                  </selectionEntryGroups>
                </selectionEntry>
                <selectionEntry id="7d69-fcce-8d5d-4723" name="Graviton rifle" hidden="false" type="upgrade" collective="false" import="true">
