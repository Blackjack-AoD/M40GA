                <selectionEntry id="a94c-89ce-b803-ce5b" name="Rampart crest" hidden="false" type="upgrade" collective="false" import="true">
                  <constraints>
                    <constraint id="e153-eab5-a9a0-5eb3" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
