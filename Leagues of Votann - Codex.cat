e" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2, Twin-linked</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-mlfrag" name="Missile Launcher (frag missiles)" hidden="false" type="upgrade" collective="false" import="true"><profiles><profile id="dd84-8915-82c8-49c5" name="Frag missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">6</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Blast</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-mlkf" name="Missile Launcher (krak and flakk missiles)" hidden="false" type="upgrade" collective="false" import="true"><profiles><profile id="d0ea-8c31-48b8-4a06" name="Krak missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1</characteristic></characteristics></profile><profile id="f928-3c01-45fa-4172" name="Flakk missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Skyfire, Blast</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-cyc" name="Cyclone Missile Launcher" hidden="false" type="upgrade" collective="false" import="true"><profiles><profile id="dc99-7f08-665c-4df8" name="Cyclone krak missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2</characteristic></characteristics></profile><profile id="2890-4c1e-70d5-44d7" name="Cyclone frag missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">6</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2, Blast</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-cycf" name="Cyclone Missile Launcher (with flakk missiles)" hidden="false" type="upgrade" collective="false" import="true"><profiles><profile id="9a34-1b0a-4912-4d4d" name="Cyclone krak missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2</characteristic></characteristics></profile><profile id="07a6-0f6e-263f-4676" name="Cyclone frag missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">6</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2, Blast</characteristic></characteristics></profile><profile id="0a8e-639a-396f-4865" name="Cyclone flakk missile" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2, Skyfire, Blast</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-sniper" name="Sniper Rifle" hidden="false" type="upgrade" collective="false" import="true"><profiles><profile id="4431-443f-92b9-44ed" name="Sniper Rifle" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36&quot;</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">X</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">6</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Sniper</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-ccw" name="Close Combat Weapon" hidden="false" type="upgrade" collective="false" import="true"><profiles><profile id="f33a-79a7-36cd-4d88" name="Close Combat Weapon" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon"><characteristics><characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic><characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic><characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic><characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-prey" name="Preymark Crest" hidden="false" type="upgrade" collective="false" import="true"><rules><rule id="581b-356f-38dd-4844" name="Preymark Crest" hidden="false"><description>A unit containing a model equipped with a preymark crest gains the Precision Shots and Precision Strikes special rules.</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-smoke" name="Smoke Launcher" hidden="false" type="upgrade" collective="false" import="true"><rules><rule id="82bd-af8f-429b-45c1" name="Smoke Launcher" hidden="false"><description>Once per game, instead of shooting or flat out movements/running, the vehicle can activate smoke launchers. May not fire its weapons that turn but receives a 5+ cover save until next player turn. Unaffected by weapon destroyed, crew shaken and crew stunned results.</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-search" name="Searchlight" hidden="false" type="upgrade" collective="false" import="true"><rules><rule id="000f-52a2-01ef-46ac" name="Searchlight" hidden="false"><description>Night fighting only. It can illuminate a target it has fired at. Illuminates itself in the process (illuminated units lose Night Fighting benefits).</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-defgren" name="Defensive Grenades" hidden="false" type="upgrade" collective="false" import="true"><rules><rule id="b5c4-c6f1-524e-4cd9" name="Defensive Grenades" hidden="false"><description>If a unit with Defensive Grenades is charged while it is in cover, the charging models fight at Initiative 1 unless they also have Assault Grenades.</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-raidr" name="RAIDR Rocket Pack (Jump Pack)" hidden="false" type="upgrade" collective="false" import="true"><rules><rule id="0fb7-6ab3-f8ff-487d" name="RAIDR Rocket Pack (Jump Pack)" hidden="false"><description>A model equipped with a RAIDR Rocket Pack counts as equipped with a Jump Pack: its unit type changes to Jump Infantry (see the main rulebook).</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-mastercraft" name="Master-crafted" hidden="false" type="upgrade" collective="false" import="true"><rules><rule id="cf6c-71ec-51e5-4998" name="Master-crafted" hidden="false"><description>The chosen weapon gains the Master-crafted special rule.</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="s3-geokinesis" name="Discipline: Geokinesis" hidden="false" type="upgrade" collective="false" import="true"><profiles><profile id="c2a0-0c7f-1510-41af" name="(Primaris) Chasm" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power"><characteristics><characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">2</characteristic><characteristic name="Power Category" typeId="f04c-a782-d794-ddad">N/A</characteristic><characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic><characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Chasm is a psychic power that targets an enemy unit within 18&quot; of the Psyker that is not locked in combat. All models in the enemy unit must immediately take a Dangerous Terrain test with no armour saves allowed (invulnerable saves can be taken normally). This psychic power has no effect on Swooping or Zooming units.</characteristic></characteristics></profile><profile id="66e5-ecf9-b57e-4db5" name="1 - Earth Blood" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power"><characteristics><characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic><characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Blessing</characteristic><characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic><characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Earth Blood is a blessing that targets a single friendly non-vehicle character within 18&quot;. The target immediately regains D3 wounds lost earlier during the battle. In addition, whilst the power is in effect, the target and all models in their unit have the It Will Not Die special rule.</characteristic></characteristics></profile><profile id="fdcf-492c-8d4c-4db8" name="2 - Scorched Earth" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power"><characteristics><characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic><characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Malediction</characteristic><characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic><characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Scorched Earth is a malediction that targets a point on the battlefield within 24&quot; of the Psyker. Choose the point when the power is manifested. Each unit within 6&quot; of that point immediately suffers a single Strength 5 AP4 hit with the Ignores Cover special rule (hits are Randomly Allocated). In addition, whilst the power is in effect, all terrain (including open ground) within 6&quot; of the point chosen is treated as being dangerous terrain.</characteristic></characteristics></profile><profile id="b964-1517-e977-40e4" name="3 - Landquake" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power"><characteristics><characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic><characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Malediction</characteristic><characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic><characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Landquake is a malediction that targets all enemy units within 18&quot;. Whilst this power is in effect, the targets move as though they were in difficult terrain. Furthermore, whilst this power is in effect, the targets cannot Run, Turbo-boost, or move Flat Out. This psychic power has no effect on Swooping or Zooming units.</characteristic></characteristics></profile><profile id="71d8-64ed-10f4-436c" name="4 - Phase Form" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power"><characteristics><characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic><characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Blessing</characteristic><characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic><characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Phase Form is a blessing that targets a single friendly unit within 24&quot;. Whilst the power is in effect, the unit has the Move Through Cover special rule and all of its weapons have the Ignores Cover special rule. In addition, the unit does not need line of sight in order to attack an enemy unit in the Shooting phase - as long as the target is in range, it can be shot at.</characteristic></characteristics></profile><profile id="2168-75e2-6c6d-42dd" name="5 - Warp Quake" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power"><characteristics><characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic><characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Witchfire</characteristic><characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic><characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Warp Quake is a witchfire power that targets either a single building or a single piece of Ruins terrain within 24&quot;. If you targeted a building, roll a dice; on a roll of 1-3, the building suffers a glancing hit, and on a roll of 4-6, it suffers a penetrating hit. If you targeted a piece of Ruins terrain, roll a dice for each unit that is even partially within those ruins: on a 4 or more, that unit suffers D6 Strength 6 AP- hits as they are struck by falling debris. These hits are Randomly Allocated.</characteristic></characteristics></profile><profile id="7195-0503-dfa0-43d5" name="6 - Shifting Worldscape" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power"><characteristics><characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">3</characteristic><characteristic name="Power Category" typeId="f04c-a782-d794-ddad">N/A</characteristic><characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic><characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Shifting Worldscape is a psychic power that targets a single terrain feature within 24&quot; of the Psyker and in their line of sight. The terrain feature must be one that can be physically picked up and placed in a different location on the battlefield. Move the terrain to an area of open ground anywhere on the battlefield within 24&quot; of its starting position, so long as it is more than 1&quot; away from any other models or other terrain features after the relocation is complete. Any units that have all of their models on the piece of terrain are moved with it. If a unit has only a portion of its models on the terrain feature, then the models that occupy the terrain piece are immediately moved off it by their player, in the same manner as a model disembarking from a vehicle (treating the edge of the terrain as an Access Point and ending this move wholly within 6&quot; of the terrain and in coherency). Models moved in this way must then take a Dangerous Terrain test.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry></sharedSelectionEntries>
<sharedSelectionEntryGroups><selectionEntryGroup id="grp-20116" name="Warlord Trait (if Warlord, choose 1 or roll D6)" hidden="false" collective="false">
      <constraints>
        <constraint id="c-20117" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="c-20118" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries><selectionEntry id="wt-20104" name="Ancestral Bearing" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20105" name="Ancestral Bearing" hidden="false"><description>The Warlord gains the Resolute special rule, and friendly units within 12" of the Warlord also benefit from the Resolute special rule. In addition, when determining assault results for any of your units in combat, add 1 to your total if your Warlord is engaged in combat.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20106" name="Warrior Lord" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20107" name="Warrior Lord" hidden="false"><description>The Warlord and any unit they join gain the Monster Hunter and Furious Charge special rules.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20108" name="A Long List" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20109" name="A Long List" hidden="false"><description>The Warlord and the unit they join suffer the Hatred(Enemy Warlord) special rule. After deploying but before rolling to seize the initiative, place a single Grudge Token on the enemy Warlord's unit.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20110" name="Guild Affiliate" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20111" name="Guild Affiliate" hidden="false"><description>You may re-roll To Hit rolls of 1 when shooting and in combat for the Warlord and the unit they join.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20112" name="Unrelenting Toil" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20113" name="Unrelenting Toil" hidden="false"><description>Your units gain the Move Through Cover special rule. Your Warlord confers the Counter Attack special rule to them and their unit.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry><selectionEntry id="wt-20114" name="Grim Demeanour" hidden="false" type="upgrade" collective="false">
          <rules><rule id="rule-20115" name="Grim Demeanour" hidden="false"><description>The Warlord gains the Fearless and the It Will Not Die special rules.</description></rule></rules>
          <costs><cost name="pts" typeId="points" value="0" /></costs>
        </selectionEntry></selectionEntries>
    </selectionEntryGroup><selectionEntryGroup id="grp-20147" name="Relics" hidden="false" collective="false">
      <constraints>
        <constraint id="c-20148" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="c-20149" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries><selectionEntry id="rl-20119" name="Aktôl's Fortress" hidden="false" type="upgrade" collective="false"><rules><rule id="rule-20120" name="Aktôl's Fortress" hidden="false"><description>In the first round of an assault, enemy units engaged with the bearer strike at initiative 1.</description></rule></rules><costs><cost name="pts" typeId="points" value="40" /></costs></selectionEntry><selectionEntry id="rl-20121" name="Ancestral Crest" hidden="false" type="upgrade" collective="false"><rules><rule id="rule-20122" name="Ancestral Crest" hidden="false"><description>This relic may only be purchased by your Warlord. At the start of your turn, you may choose to replace your current warlord trait by randomly generating a new warlord trait from any table available to your warlord.</description></rule></rules><costs><cost name="pts" typeId="points" value="35" /></costs></selectionEntry><selectionEntry id="rl-20123" name="Exactor" hidden="false" type="upgrade" collective="false"><profiles><profile id="prof-20124" name="Exactor" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Concussive, Sunder, Unwieldy, Specialist Weapon, Shatter</characteristic>
          </characteristics>
        </profile></profiles><rules><rule id="691a-150d-8bee-4d29" name="Shatter" hidden="false"><description>To Wound rolls of 6 are resolved as having the Instant Death special rule.</description></rule></rules><costs><cost name="pts" typeId="points" value="20" /></costs></selectionEntry><selectionEntry id="rl-20125" name="The First Knife" hidden="false" type="upgrade" collective="false"><profiles><profile id="prof-20126" name="The First Knife" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Rending, Votann Diplomacy</characteristic>
          </characteristics>
        </profile></profiles><rules><rule id="c06f-0348-5d82-4d48" name="Votann Diplomacy" hidden="false"><description>Against To Wound rolls of 6, enemies may not make Invulnerable saving throws.</description></rule></rules><costs><cost name="pts" typeId="points" value="5" /></costs></selectionEntry><selectionEntry id="rl-20127" name="Flâyre" hidden="false" type="upgrade" collective="false"><profiles><profile id="prof-20128" name="Flâyre" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+1</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Rending, Unwieldy, Blind</characteristic>
          </characteristics>
        </profile></profiles><costs><cost name="pts" typeId="points" value="10" /></costs></selectionEntry><selectionEntry id="rl-20129" name="Wayfarer's Grace" hidden="false" type="upgrade" collective="false"><rules><rule id="rule-20130" name="Wayfarer's Grace" hidden="false"><description>The bearer gains the Feel No Pain (4+) special rule.</description></rule></rules><costs><cost name="pts" typeId="points" value="20" /></costs></selectionEntry><selectionEntry id="rl-20131" name="The Grey Crest" hidden="false" type="upgrade" collective="false"><rules><rule id="rule-20132" name="The Grey Crest" hidden="false"><description>The bearer counts as having Defensive Grenades and confers the Stealth special rule to them and their unit.</description></rule></rules><costs><cost name="pts" typeId="points" value="25" /></costs></selectionEntry><selectionEntry id="rl-20133" name="Grudge's End" hidden="false" type="upgrade" collective="false"><profiles><profile id="prof-20134" name="Grudge's End" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24"</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2, Enmity Protocols</characteristic>
          </characteristics>
        </profile></profiles><rules><rule id="40b1-3429-a71d-4bdf" name="Enmity Protocols" hidden="false"><description>Add 1 to the number of shots and strength of this weapon for each Grudge token on the targeted enemy unit.</description></rule></rules><costs><cost name="pts" typeId="points" value="15" /></costs></selectionEntry><selectionEntry id="rl-20135" name="Wârpestryk" hidden="false" type="upgrade" collective="false"><rules><rule id="rule-20136" name="Wârpestryk" hidden="false"><description>Once per game at the start of your movement phase, if the bearer and their unit is unengaged, you may pick up and redeploy the bearer's unit anywhere on the battlefield as if arriving from Deep Strike. Roll to scatter as normal.</description></rule></rules><costs><cost name="pts" typeId="points" value="20" /></costs></selectionEntry><selectionEntry id="rl-20137" name="The Hearthfist" hidden="false" type="upgrade" collective="false"><profiles><profile id="prof-20138" name="The Hearthfist" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+3</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Concussive, Gets Hot, Specialist Weapon, Searing Strike</characteristic>
          </characteristics>
        </profile></profiles><rules><rule id="c0ed-559a-7149-420b" name="Searing Strike" hidden="false"><description>Instead of attacking normally, the bearer may unleash a torrent of plasma. Place the flame template with the wide end in base contact with the bearer, angled in any direction that does not hit friendly models. All enemies hit by the template suffer a S4 AP4 automatic Hit.</description></rule></rules><costs><cost name="pts" typeId="points" value="25" /></costs></selectionEntry><selectionEntry id="rl-20139" name="The Murmuring Stave" hidden="false" type="upgrade" collective="false"><profiles><profile id="4a1a-1575-9b6b-484f" name="The Murmuring Stave" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Force, Haywire, Master-crafted, Ancestral Guidance</characteristic>
          </characteristics>
        </profile></profiles><rules><rule id="f09e-4de4-1b86-4830" name="Ancestral Guidance" hidden="false"><description>When manifesting a psychic power against an enemy unit, you may reroll a die during the attempt for every Grudge token on that enemy unit.</description></rule></rules><costs><cost name="pts" typeId="points" value="20" /></costs></selectionEntry><selectionEntry id="rl-20141" name="Thyrikite Plate" hidden="false" type="upgrade" collective="false"><rules><rule id="rule-20142" name="Thyrikite Plate" hidden="false"><description>Before an enemy rolls To Wound against the bearer, the Toughness characteristic of the bearer is treated as being one higher for every Hit inflicted.</description></rule></rules><costs><cost name="pts" typeId="points" value="35" /></costs></selectionEntry><selectionEntry id="rl-20143" name="Vôlumm's Master Artifice" hidden="false" type="upgrade" collective="false"><profiles><profile id="prof-20144" name="Vôlumm's Master Artifice" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Template</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">*</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault, Graviton, Concussive</characteristic>
          </characteristics>
        </profile></profiles><costs><cost name="pts" typeId="points" value="30" /></costs></selectionEntry><selectionEntry id="rl-20145" name="Ymmâ's Shield" hidden="false" type="upgrade" collective="false"><rules><rule id="rule-20146" name="Ymmâ's Shield" hidden="false"><description>The bearer may re-roll Saving Throws of 1.</description></rule></rules><costs><cost name="pts" typeId="points" value="15" /></costs></selectionEntry></selectionEntries>
    </selectionEntryGroup></sharedSelectionEntryGroups><sharedRules><rule id="rule-20001" name="Assistant" hidden="false"><description>A model with this rule does not prevent their attached character from joining another unit, this model simply joins the same unit as well.</description></rule><rule id="rule-20003" name="Brôkhyr's Guild" hidden="false"><description>In your shooting phase, instead of firing weapons, a model with this rule can repair a vehicle that they are embarked upon or in base contact with. To repair, roll a D6 and add +1 for each E-COG in the unit. On a 5+, either restore a hull point or remove a Weapon Destroyed or Immobilised result from that vehicle. If this unit contains an Ironkin Assistant, you can pick two different effects on a successful repair roll, but not 2 of the same.</description></rule><rule id="rule-20004" name="Companion" hidden="false"><description>Models with this rule are not targetable in any way. Models with this rule do not block line of sight and other models may move over and through models with this rule. When the attached character and their unit moves, place these models as close as possible to the attached character. When the attached character is slain, remove these models with this rule. Models with this rule may make attacks in the shooting/combat phase, in which case they can target any eligible models that their attached character can target. Models with this rule never gain the benefits for assaulting.</description></rule><rule id="rule-20005" name="Cyberstimms" hidden="false"><description>When slain in combat, a model with this rule is not removed as a casualty until after it makes its attacks this combat phase. If the model has already attacked when it was slain, then this rule does not take effect.</description></rule><rule id="rule-20006" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="rule-20007" name="Grim Efficiency" hidden="false"><description>After deploying but before rolling to seize the initiative, as long as you have a model with this rule in your army, place a single Grudge Token on an enemy unit.</description></rule><rule id="rule-20008" name="Mounted Assault" hidden="false"><description>When deploying a unit with this rule that has purchased dedicated transports, you may split the squad into separate units. Split the squad so that each vehicle has its transport capacity as filled as possible. The dedicated transports and the models embarked within them are then considered separate units for all intents and purposes. Any remaining models that cannot embark upon the dedicated transports remain as their own separate unit.</description></rule><rule id="rule-20009" name="Resolute" hidden="false"><description>Units with this special rule roll 3D6 when taking leadership tests, discarding the highest die.</description></rule><rule id="rule-20010" name="Spark of the Votann" hidden="false"><description>See "Power of the Machine Spirit" in the main rulebook.</description></rule><rule id="rule-20011" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3" instead of rolling to determine the distance.</description></rule><rule id="rule-20012" name="Swivel Actuators" hidden="false"><description>Sponson weapons on a vehicle with this rule have a 180 degree field of fire rather than the usual 90 degrees.</description></rule><rule id="rule-20013" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule><rule id="usr-loneop-001" name="Lone Operative" hidden="false"><description>Unless this model has joined a unit, it can only be selected as the target of a ranged attack if the firing model is within 12".</description></rule><rule id="rule-20401" name="Experimental Munitions" hidden="false"><description>Boltguns, Bolt Pistols, and Heavy Bolters in a unit with a model with this rule gain the Poisoned (4+) special rule.</description></rule><rule id="rule-20402" name="Retinue" hidden="false"><description>Characters with this rule do not take up a force organization slot. Instead, for every HQ taken, you may take one Character with this rule. What units these Characters may deploy within are indicated on their Datasheet. Only a single model with this rule may be attached to the same unit, and a model with this rule may not be nominated as your warlord.</description></rule></sharedRules></catalogue>