        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Blessing, self only. If manifested, gain 1 Command Point (or the army-rule benefit you use in place of CP)."/>
      </characteristics></profile></profiles>
