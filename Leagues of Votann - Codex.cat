  </constraints>
  <rules>
    <rule id="rule-20395" name="Transport Capacity" hidden="false"><description>A Hekaton Land Fortress has a transport capacity of 12 models. It has an access point on every side of the vehicle.</description></rule>
    <rule id="rule-20396" name="Void Armour" hidden="false"><description>Models with this rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule>
    <rule id="rule-20397" name="Assault Vehicle" hidden="false"><description>This vehicle has the Assault Vehicle special rule.</description></rule>
    <rule id="rule-20398" name="Spark of the Votann" hidden="false"><description>See "Power of the Machine Spirit" in the main rulebook.</description></rule>
    <rule id="rule-20399" name="Swivel Actuators" hidden="false"><description>Sponson weapons on a vehicle with this rule have a 180 field of fire rather than the usual 90 degrees.</description></rule>
  </rules>
