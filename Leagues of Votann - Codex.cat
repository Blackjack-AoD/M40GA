          <profiles>
            <profile id="d54d-8780-3301-c3c7" name="Cthonian Earthshaker" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
              <characteristics>
                <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic>
