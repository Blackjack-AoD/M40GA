                <selectionEntry id="5c38-445a-9df7-73e9" name="Heavy volkanite disintegrator" hidden="false" type="upgrade" collective="false" import="true">
                  <constraints>
                    <constraint id="d6bd-d548-f228-48fa" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
