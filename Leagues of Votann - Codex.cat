        <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c-9053" type="min"/>
        <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c-9054" type="max"/>
      </constraints>
      <selectionEntries><selectionEntry id="pp-9040" name="Grudgepyre (WC4)" hidden="false" collective="false" type="upgrade">
            <profiles><profile id="prof-9041" name="Grudgepyre (WC4)" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82"><profiles/><rules/><infoLinks/><modifiers/><characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Witchfire. Target one visible enemy unit within 18&quot; (not Vehicle/Monster/Character). Roll 2D6: if it beats that unit's unmodified Leadership, your opponent removes one model as a casualty."/>
      </characteristics></profile></profiles>
            <rules/><infoLinks/><modifiers/><constraints/>
            <selectionEntries/><selectionEntryGroups/><entryLinks/>
            <costs><cost name="pts" costTypeId="points" value="0.0"/></costs>
          </selectionEntry><selectionEntry id="pp-9042" name="Ancestral Wrath (WC6)" hidden="false" collective="false" type="upgrade">
            <profiles><profile id="prof-9043" name="Ancestral Wrath (WC6)" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82"><profiles/><rules/><infoLinks/><modifiers/><characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Witchfire. Target one visible enemy unit within 18&quot; and roll 3 dice (6 dice if it has 11+ models). Each roll of 4+ causes 1 mortal wound."/>
      </characteristics></profile></profiles>
            <rules/><infoLinks/><modifiers/><constraints/>
            <selectionEntries/><selectionEntryGroups/><entryLinks/>
            <costs><cost name="pts" costTypeId="points" value="0.0"/></costs>
          </selectionEntry><selectionEntry id="pp-9044" name="Fortify (WC6)" hidden="false" collective="false" type="upgrade">
            <profiles><profile id="prof-9045" name="Fortify (WC6)" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82"><profiles/><rules/><infoLinks/><modifiers/><characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Blessing. Target one friendly Core or Character unit within 12&quot;. Until your next Psychic phase: +1 Toughness, and each time a model in that unit would lose a wound, roll a D6 - on a 6 the wound isn't lost."/>
      </characteristics></profile></profiles>
            <rules/><infoLinks/><modifiers/><constraints/>
            <selectionEntries/><selectionEntryGroups/><entryLinks/>
            <costs><cost name="pts" costTypeId="points" value="0.0"/></costs>
          </selectionEntry><selectionEntry id="pp-9046" name="Crushing Contempt (WC6)" hidden="false" collective="false" type="upgrade">
            <profiles><profile id="prof-9047" name="Crushing Contempt (WC6)" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82"><profiles/><rules/><infoLinks/><modifiers/><characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Malediction. Target one enemy unit within 18&quot;. Roll 3D6: if it beats their Leadership, they cannot perform special actions until your next Psychic phase; if it exceeds Leadership, they also suffer -1 to hit until then."/>
      </characteristics></profile></profiles>
            <rules/><infoLinks/><modifiers/><constraints/>
            <selectionEntries/><selectionEntryGroups/><entryLinks/>
            <costs><cost name="pts" costTypeId="points" value="0.0"/></costs>
          </selectionEntry><selectionEntry id="pp-9048" name="Null Vortex (WC8)" hidden="false" collective="false" type="upgrade">
            <profiles><profile id="prof-9049" name="Null Vortex (WC8)" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82"><profiles/><rules/><infoLinks/><modifiers/><characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Malediction. Target one enemy unit within 12&quot;. Until your next Psychic phase, models in that unit cannot use invulnerable saves."/>
      </characteristics></profile></profiles>
            <rules/><infoLinks/><modifiers/><constraints/>
