    <selectionEntry id="878d-e170-c09f-89b4" name="Arkanyst Evaluator" hidden="false" type="model" collective="false" import="true">
      <comment>Converted from wh40k-10e by translate.py. Source catalogue f616-3f08-ee8e-3349, source entry e5c2-d1a0-b54d-65df, source name 'Arkanyst Evaluator'.</comment>
