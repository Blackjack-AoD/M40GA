                    <constraint id="d15d-b2ea-8a2a-deaa" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <constraint id="ab8d-c166-6a14-ae06" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
