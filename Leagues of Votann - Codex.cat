ections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="c879-1710-961a-4e36" name="Plasma Blade Gauntlet" hidden="false" collective="false" import="true" targetId="wpn-20048" type="selectionEntry"><constraints><constraint id="cd72-7f41-4c04-451c" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="cf10-52a9-b649-4f7b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><rules><rule id="0a30-e5da-4e9a-45d5" name="Replace the entire unit's Concussion Gauntlets for Plasma Blade Gauntlets (Hearthguard)" hidden="false"><description>Replaces every Hearthguard Concussion Gauntlet. Free.</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry><selectionEntry id="26b6-f9a5-7052-476a" name="The entire unit may purchase close combat weapons" hidden="false" type="upgrade" collective="false" import="true"><modifiers><modifier type="increment" field="points" value="2"><repeats><repeat field="selections" scope="parent" childId="470a-43ff-ffa8-4cad" value="1" repeats="1" roundUp="false" shared="true" includeChildSelections="false" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="points" value="2"><repeats><repeat field="selections" scope="parent" childId="8b19-b091-39a6-4766" value="1" repeats="1" roundUp="false" shared="true" includeChildSelections="false" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="points" value="2"><repeats><repeat field="selections" scope="parent" childId="94f7-dd2c-5dbc-44c9" value="1" repeats="1" roundUp="false" shared="true" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><constraints><constraint id="dbdf-4423-36ec-4633" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="5aff-0cec-3686-4286" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="c593-799e-6aa1-450e" name="Close Combat Weapon" hidden="false" collective="false" import="true" targetId="s3-ccw" type="selectionEntry"><constraints><constraint id="d294-b182-2ee0-42cd" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="fd02-cd45-5807-4cd1" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks><rules><rule id="6f32-9e78-f532-4d10" name="The entire unit may purchase close combat weapons" hidden="false"><description>2 pts per model in the unit.</description></rule></rules><costs><cost name="pts" typeId="points" value="0" /></costs></selectionEntry></selectionEntries><profiles><profile id="9537-6679-5d54-4595" name="Hearthguard" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">5</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic></characteristics></profile><profile id="d79d-44b0-9e10-4d3e" name="Hesyr" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit"><characteristics><characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic><characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic><characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic><characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic><characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">5</characteristic><characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic><characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic><characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic><characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic><characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic></characteristics></profile></profiles><rules><rule id="e3fd-0087-fc9a-4c30" name="Bulky" hidden="false"><description>This unit has the Bulky special rule (see the main rulebook).</description></rule><rule id="f322-a5b5-b244-4bb9" name="Eye of the Ancestors" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other. Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has, their effects incrementally increasing to match the heightened threat of the foe. 1: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token. 2: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens. 3: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens. In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge.</description></rule><rule id="d459-d98e-360e-44f7" name="Resolute" hidden="false"><description>Units with this special rule roll 3D6 when taking leadership tests, discarding the highest die.</description></rule><rule id="7cf8-8936-3c4c-417a" name="Steady Advance" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3&quot; instead of rolling to determine the distance.</description></rule><rule id="bbce-cdad-e70b-4440" name="Void Armour" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour.</description></rule></rules><costs><cost name="pts" typeId="points" value="175" /></costs></selectionEntry><selectionEntry id="e7c1-1f53-8547-6f4f" name="Cthonian Beserks" hidden="false" type="unit" collective="false" import="true"><categoryLinks><categoryLink id="b501-96a0-1774-4431" name="Elites" hidden="false" targetId="638d74c6-bd97-4de5-b65a-6aaa24e9f4b2" primary="true" /></categoryLinks><selectionEntries><selectionEntry id="703f-dc71-f10a-452a" name="Beserk" hidden="false" type="model" collective="false" import="true"><modifiers><modifier type="increment" field="d280-e389-d73e-4fd4" value="-1"><repeats><repeat field="selections" scope="parent" childId="328b-3454-4d4a-4b2f" value="1" repeats="1" roundUp="false" shared="true" includeChildSelections="false" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="3543-632c-8c9d-4286" value="-1"><repeats><repeat field="selections" scope="parent" childId="328b-3454-4d4a-4b2f" value="1" repeats="1" roundUp="false" shared="true" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><constraints><constraint id="d280-e389-d73e-4fd4" type="min" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="3543-632c-8c9d-4286" type="max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="c546-60bd-5478-4853" name="Heavy Plasma Axe" hidden="false" collective="false" import="true" targetId="wpn-20044" type="selectionEntry"><constraints><constraint id="4be1-8f6d-3c65-42d5" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="9c09-01c0-0f84-4ee1" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink><entryLink id="252e-1c83-6bfc-4c18" name="Assault Grenades" hidden="false" collective="false" import="true" targetId="eq-20410" type="s